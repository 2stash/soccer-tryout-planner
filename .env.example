EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Used as the password-reset redirect base (no trailing slash).
# Example for Expo web: http://localhost:8081
# Also set this same origin as Site URL + Redirect URL in Supabase Auth settings.
# EXPO_PUBLIC_APP_URL=http://localhost:8081

# Server-only. Never ship this to the client. Used by scripts/set-user-password.mjs
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
