EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional locally; required on Vercel for password-reset / auth redirects.
# No trailing slash. Example local: http://localhost:8081
# Example prod: https://your-app.vercel.app
# Also add that origin under Supabase → Authentication → URL configuration
# (Site URL + Redirect URLs, including /reset-password).
# EXPO_PUBLIC_APP_URL=http://localhost:8081

# Server-only. Never ship this to the client. Used by scripts/set-user-password.mjs
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
